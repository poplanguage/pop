namespace Example.HttpServer
using Pop.Net
using Pop.Text
using Pop.File
using Pop.Http
using Example.HttpServer.Site

private function serve(stream: Net.Tcp.Stream, access: File.Access)
    local input = Bytes.withCapacity(8192)
    local transfer = Net.Tcp.receive(stream, input, UInt64(8192))
    while Net.transferWouldBlock(transfer) do
        transfer = Net.Tcp.receive(stream, input, UInt64(8192))
    end

    if local text = Text.decodeUtf8(input) then
        if local request = parseRequest(text, UInt64(8192)) then
            if local reply = route(request, access) then
                sendResponse(stream, reply)
            end
        else
            if local reply = routeGet(text, access) then
                sendResponse(stream, reply)
            end
        end
    end
    Net.Tcp.shutdownWrite(stream)
    Net.Tcp.closeStream(stream)
end

private function main()
    local access = File.Access.open(".")
    local listener = Net.Tcp.listen(UInt16(18080))
    print("Pop HTTP server listening on 127.0.0.1:18080")

    while true do
        local stream = Net.Tcp.accept(listener)
        if stream ~= nil then
            serve(stream, access)
        end
    end
end
